<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <NugetAuditMode>all</NugetAuditMode>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateSBOM>true</GenerateSBOM>
    <!-- This should be the published baseline version to validate against.
    <PackageValidationBaselineVersion>0.0.1</PackageValidationBaselineVersion>
    -->

    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))AND !$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Settings for all tests projects specifically. -->
  <PropertyGroup>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CA1000: Static members on generic types. Standard C# practice, no usability issue.
      CA1002: Don't expose List<T>. Library types are sealed; List<T> ergonomics preferred.
      CA1031: Catch general exception. Used in debugger display code where any failure must be swallowed.
      CA1711: Names ending in 'Delegate'. Applied to actual delegate declarations where the suffix is correct.
      CA1716: Identifier contains type name. The library name, namespace and typename are as designed.
      CA1720: Identifier contains type name. The library name, namespace and typename are as designed.
      CA1724: Type names should be unique. The library name, namespace and typename are as designed.
      CA1819: Properties returning arrays. Low-level crypto and TPM types expose raw byte arrays by design.
      CA2225: Named alternatives for operators. Only consumed from C# and F#, both support operators natively.
      CA2227: Read-only collection properties. POCOs require settable properties for deserialization.
    -->
    <NoWarn>$(NoWarn);CA1000;CA1002;CA1031;CA1711;CA1716;CA1720;CA1724;CA1819;CA2225;CA2227</NoWarn>
  </PropertyGroup>

  <!-- Common nuget package parameters and resources. -->
  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>Lumoin and contributors</Authors>
    <Product>Lumoin.Veritas</Product>
    <!-- A real default description (projects override with a specific one); without it NuGet
         stamps the placeholder "Package Description" into the nuspec. -->
    <Description>$(MSBuildProjectName) is part of Lumoin.Veritas, an integrated .NET stack for RDF: graph storage, SPARQL, dataset canonicalization, JSON-LD, SHACL validation, and related W3C standards.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Copyright>Lumoin</Copyright>
    <PackageIcon>resources/lumoin-veritas-nuget-logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/lumoin/Lumoin.Veritas/</PackageProjectUrl>
    <Company>Lumoin</Company>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/lumoin/Veritas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- These are set by the continous integration build (see main.yml). -->
    <PackageVersion>0.0.0</PackageVersion>
    <AssemblyVersion>0.0.0</AssemblyVersion>
    <FileVersion>0.0.0</FileVersion>
    <Version>0.0.0</Version>
    <AssemblyInformationalVersion>0.0.0</AssemblyInformationalVersion>
    <NeutralLanguage>en-US</NeutralLanguage>

    <AppendToReleaseNotesProperty>
      <![CDATA[
See full changelog at https://github.com/lumoin/Veritas/blob/main/CHANGELOG.md.]]>
    </AppendToReleaseNotesProperty>
    <ChangelogFile>../../CHANGELOG.md</ChangelogFile>


    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIL.ReleaseTasks" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Banned-API analyzer. The package is referenced privately so
    consumers don't pick it up transitively; BannedSymbols.txt at
    the repo root is added as AdditionalFiles for every project
    (including .Tests and .Benchmarks) so test code is held to the
    same clock-discipline as production. Fixes are listed in
    BannedSymbols.txt itself — typically "use TimeProvider".

    BannedSymbols.Linq.txt bans the unsized LINQ/Immutable materialization
    operators (ToArray/ToList/ToHashSet/ToLookup/ToImmutable*) — a hot-path
    allocation discipline for library code. It is added to every project
    EXCEPT *.Tests: test code may use LINQ freely (clarity over the
    allocation concern that motivates the ban in production).

    BannedSymbols.Serialization.txt bans the System.Text.Json
    namespace; it is added to every project except the JSON engine and
    binding projects that own that dependency (Lumoin.Veritas.Json.Stj,
    Lumoin.Veritas.Rdf.Json) and Lumoin.Veritas.Cbor. The base
    Lumoin.Veritas.Json model project is bound by the ban: it is
    backend-agnostic and reaches System.Text.Json only through the
    injected parse delegate implemented in Lumoin.Veritas.Json.Stj.
    Tests are not exempt for the JSON ban; uniform discipline matches the
    clock ban above.

    BannedSymbols.Xml.txt bans the System.Xml / System.Xml.Linq
    namespaces; it is added to every project except Lumoin.Veritas.Xml,
    which owns the System.Xml dependency (the SPARQL Query Results XML
    reader lives there). Tests are not exempt, matching the JSON ban.

    BannedSymbols.Cbor.txt bans the System.Formats.Cbor namespace; it
    is added to every project except Lumoin.Veritas.Cbor itself and
    any *.Tests project. The test exemption exists so the project's
    CBOR codec can be exercised against the BCL CBOR codec in
    differential property tests; library projects, the serialization
    projects, and benchmark projects remain bound by the ban.

    BannedSymbols.Entropy.txt bans System.Random, RandomNumberGenerator,
    and Guid.NewGuid so randomness and identities flow through the
    injected RandomnessDelegate / IdentifierDelegate seams (see
    VeritasRandomness / VeritasIdentifiers). It is added to every project
    except the perf/exploration harnesses (Lumoin.Veritas.Benchmarks and
    Lumoin.Veritas.Workbench), where seeded System.Random is the idiomatic
    choice for reproducible synthetic fixtures and the ban's purpose does
    not apply. Production code that legitimately needs raw entropy (the
    Core RandomSources synthetic-graph seam, and the sanctioned
    VeritasRandomness / VeritasIdentifiers producers) suppresses RS0030
    with justification.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Linq.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Lumoin.Veritas.Json.Stj' AND '$(MSBuildProjectName)' != 'Lumoin.Veritas.Rdf.Json' AND '$(MSBuildProjectName)' != 'Lumoin.Veritas.Cbor' AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Serialization.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Lumoin.Veritas.Xml'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Xml.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Lumoin.Veritas.Cbor' AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Cbor.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Lumoin.Veritas.Benchmarks' AND '$(MSBuildProjectName)' != 'Lumoin.Veritas.Workbench'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Entropy.txt" />
  </ItemGroup>

  <!-- Pack the NuGet logo and the repository readme into packable (non-test) projects. -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <None Include="$(MSBuildThisFileDirectory)resources/lumoin-veritas-nuget-logo.png">
      <Pack>True</Pack>
      <PackagePath>/resources</PackagePath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)README.md">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
  </ItemGroup>

  <!-- SBOM for all projects. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumoin.Veritas.Tests" />
    <InternalsVisibleTo Include="Lumoin.Veritas.Benchmarks" />
  </ItemGroup>

</Project>
