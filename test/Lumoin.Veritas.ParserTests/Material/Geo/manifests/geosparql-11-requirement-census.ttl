   arm:disposition "decided" ;
   arm:evidence "Geo/GeoVocabularyGraphPatternTests.ClassIsUsableInGraphPatterns binds the typed member through a rdf:type graph pattern over geo:SpatialObjectCollection and leaves the decoy unmatched." .

[] arm:requirement "/req/core/feature-collection-class" ;
   arm:conformanceClass "core" ;
   arm:bucket "vocabulary" ;
   arm:disposition "decided" ;
   arm:evidence "Geo/GeoVocabularyGraphPatternTests.ClassIsUsableInGraphPatterns binds the typed member through a rdf:type graph pattern over geo:FeatureCollection and leaves the decoy unmatched." .

[] arm:requirement "/req/core/spatial-object-properties" ;
   arm:conformanceClass "core" ;
   arm:bucket "vocabulary" ;
   arm:disposition "decided" ;
   arm:evidence "Geo/GeoVocabularyGraphPatternTests.PropertyIsUsableInGraphPatterns binds subject and object through a graph pattern over each of the ten size, length, perimeter, area, and volume properties, leaving the decoy triple unmatched." .

[] arm:requirement "/req/core/feature-properties" ;
   arm:conformanceClass "core" ;
   arm:bucket "vocabulary" ;
   arm:disposition "decided" ;
   arm:evidence "Geo/GeoVocabularyGraphPatternTests.PropertyIsUsableInGraphPatterns binds subject and object through a graph pattern over each of geo:hasGeometry, hasDefaultGeometry, hasCentroid, and hasBoundingBox; the feature-geometry-serialization join row exercises geo:hasDefaultGeometry inside a three-pattern query." .

