<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <!--
      Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
      For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
      -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\config.runsettings</RunSettingsFilePath>
    <TestingExtensionsProfile>AllMicrosoft</TestingExtensionsProfile>
    <IsTestApplication>true</IsTestApplication>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="LiquidTestReports.Markdown" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage">
      <VersionOverride>18.6.2</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bluesky fixtures (real CAR files from public AT Protocol PDS endpoints).
         Files are populated manually per Cbor/Fixtures/Bluesky/README.md; the
         glob is non-erroring when no .car files are present. -->
    <None Include="Cbor\Fixtures\Bluesky\*.car" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- W3C RDF test cases vendored under Material/; copied to the test
         binary's output directory so W3cCorpusPath can resolve them at
         runtime. See Material/NQuads/ATTRIBUTION.md and
         Material/Turtle/ATTRIBUTION.md for provenance. -->
    <Content Include="Material\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-authored harness unit-test fixtures. Copied alongside the
         vendored W3C corpus so the harness's own tests can locate them. -->
    <Content Include="Conformance\Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Canonicalization\Lumoin.Veritas.Canonicalization.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Cbor\Lumoin.Veritas.Cbor.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.CborLd\Lumoin.Veritas.CborLd.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Cid\Lumoin.Veritas.Cid.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Core\Lumoin.Veritas.Core.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.JsonLd\Lumoin.Veritas.JsonLd.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.LinkedData\Lumoin.Veritas.LinkedData.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Json\Lumoin.Veritas.Json.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.NQuads\Lumoin.Veritas.NQuads.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Owl\Lumoin.Veritas.Owl.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Rdf\Lumoin.Veritas.Rdf.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Shacl\Lumoin.Veritas.Shacl.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Skos\Lumoin.Veritas.Skos.csproj" />
    <ProjectReference Include="..\..\src\Lumoin.Veritas.Turtle\Lumoin.Veritas.Turtle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.AzureDevOpsReport">
      <VersionOverride>2.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CrashDump">
      <VersionOverride>2.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.HangDump">
      <VersionOverride>2.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.HotReload">
      <VersionOverride>2.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.Retry">
      <VersionOverride>2.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport">
      <VersionOverride>2.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter">
      <VersionOverride>4.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework">
      <VersionOverride>4.2.1</VersionOverride>
    </PackageReference>
  </ItemGroup>

  <!--
    Workbench is a console-app project that exposes scenario operations
    (HypertrieSoak.RunBuildSoak, RunQuerySoak, ...) for both interactive
    Release-build profiling and automated test exercise. Tests references
    Workbench so:
      1) the operations can be invoked in-process for fast unit tests, and
      2) MSBuild builds Workbench before Tests, ensuring the workbench
         executable exists on disk for the integration tests that launch
         it via Process.Start.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Lumoin.Veritas.Workbench\Lumoin.Veritas.Workbench.csproj" />
  </ItemGroup>

</Project>

