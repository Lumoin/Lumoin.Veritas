	<test:TestCase rdf:about="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2DsomeValuesFrom-2D002">
		<rdf:type rdf:resource="&test;NegativeEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WebOnt-someValuesFrom-002</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jeremy J. Carroll</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A simple example showing how &lt;code&gt;owl:someValuesFrom&lt;/code&gt; differs from &lt;code&gt;owl:allValuesFrom&lt;/code&gt;.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Proposed" />
		<test:semantics rdf:resource="&test;DIRECT" />
