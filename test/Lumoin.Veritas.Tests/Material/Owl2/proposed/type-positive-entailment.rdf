    &lt;rdf:Description rdf:about=''&gt;
        &lt;owl:imports 
     rdf:resource="http://www.w3.org/2002/03owlt/imports/support001-A"/&gt;
    &lt;/rdf:Description&gt;

    &lt;ont:Man rdf:about='http://example.org/data#Socrates'/&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
