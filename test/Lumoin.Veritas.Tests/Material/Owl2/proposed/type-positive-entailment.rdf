       &lt;/owl:equivalentClass&gt;
       &lt;owl:equivalentClass&gt;
           &lt;owl:Restriction&gt;
             &lt;owl:onProperty rdf:resource="#r-N-times-M-to-1"/&gt;
             &lt;owl:someValuesFrom rdf:resource="#only-d"/&gt;
           &lt;/owl:Restriction&gt;
       &lt;/owl:equivalentClass&gt;
    &lt;/owl:Class&gt;

    &lt;rdf:Description rdf:about="#N-times-M"&gt;
      &lt;owl:sameAs 
          rdf:datatype=
"http://www.w3.org/2001/XMLSchema#int"&gt;77&lt;/owl:sameAs&gt;
     &lt;/rdf:Description&gt;

