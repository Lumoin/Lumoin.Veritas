	<test:TestCase rdf:about="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2DintersectionOf-2D001">
		<rdf:type rdf:resource="&test;PositiveEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WebOnt-intersectionOf-001</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jos De Roo</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The order of the classes in an &lt;code&gt;intersectionOf&lt;/code&gt;
construct is unimportant.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Proposed" />
		<test:semantics rdf:resource="&test;DIRECT" />
		<test:semantics rdf:resource="&test;RDF-BASED" />
		<test:species rdf:resource="&test;FULL" />
		<test:rdfXmlConclusionOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:first="http://www.w3.org/2002/03owlt/intersectionOf/premises001#"
    xml:base="http://www.w3.org/2002/03owlt/intersectionOf/conclusions001" &gt;

    &lt;first:C rdf:about="premises001#John"/&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
		<test:rdfXmlPremiseOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:first="http://www.w3.org/2002/03owlt/intersectionOf/premises001#"
    xml:base="http://www.w3.org/2002/03owlt/intersectionOf/premises001" &gt;

    &lt;rdf:Description rdf:about="premises001#B"&gt;
        &lt;owl:intersectionOf rdf:parseType="Collection"&gt;
            &lt;rdf:Description rdf:about="premises001#Student"/&gt;
            &lt;rdf:Description rdf:about="premises001#Employee"/&gt;
        &lt;/owl:intersectionOf&gt;
    &lt;/rdf:Description&gt;

    &lt;rdf:Description rdf:about="premises001#C"&gt;
        &lt;owl:intersectionOf rdf:parseType="Collection"&gt;
            &lt;rdf:Description rdf:about="premises001#Employee"/&gt;
            &lt;rdf:Description rdf:about="premises001#Student"/&gt;
        &lt;/owl:intersectionOf&gt;
    &lt;/rdf:Description&gt;

    &lt;first:B rdf:about="premises001#John"/&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
	</test:TestCase>
