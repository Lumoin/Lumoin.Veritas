	<test:TestCase rdf:about="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2DinverseOf-2D001">
		<rdf:type rdf:resource="&test;PositiveEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WebOnt-inverseOf-001</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dan Connolly</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the pair &lt;code&gt;(x,y)&lt;/code&gt; is an instance of &lt;code&gt;P&lt;/code&gt;, than the pair &lt;code&gt;(y,x)&lt;/code&gt; is an instance of the named property.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Proposed" />
		<test:semantics rdf:resource="&test;DIRECT" />
		<test:semantics rdf:resource="&test;RDF-BASED" />
