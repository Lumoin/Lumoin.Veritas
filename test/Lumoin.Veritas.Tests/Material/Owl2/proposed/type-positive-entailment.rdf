		<owl:assertionProperty rdf:resource="&test;species" />
		<owl:targetIndividual rdf:resource="&test;DL" />
	</owl:NegativePropertyAssertion>
	<owl:Thing rdf:about="http://owl.semanticweb.org/id/WebOnt-2Dimports-2D003-2Dimport-2Dsupport003-2DA">
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:importedOntologyIRI rdf:resource="http://www.w3.org/2002/03owlt/imports/support003-A" />
		<test:rdfXmlInputOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
    xmlns:rdfs='http://www.w3.org/2000/01/rdf-schema#'
    xmlns:owl='http://www.w3.org/2002/07/owl#'
    xml:base='http://www.w3.org/2002/03owlt/imports/support003-A' &gt;

    &lt;owl:Ontology rdf:about=''&gt;
        &lt;owl:imports rdf:resource='http://www.w3.org/2002/03owlt/imports/support003-B'/&gt;
    &lt;/owl:Ontology&gt;

    &lt;owl:Class rdf:ID='Man'&gt;
        &lt;rdfs:subClassOf rdf:resource='#Person'/&gt;
    &lt;/owl:Class&gt;

    &lt;owl:Class rdf:ID='Person'/&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlInputOntology>
	</owl:Thing>
	<owl:Thing rdf:about="http://owl.semanticweb.org/id/WebOnt-2Dimports-2D003-2Dimport-2Dsupport003-2DB">
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:importedOntologyIRI rdf:resource="http://www.w3.org/2002/03owlt/imports/support003-B" />
