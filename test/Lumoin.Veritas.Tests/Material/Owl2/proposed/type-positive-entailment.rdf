		<test:rdfXmlConclusionOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xml:base="http://www.w3.org/2002/03owlt/disjointWith/conclusions002" &gt;
    &lt;rdf:Description rdf:about="premises002#a"&gt;
       &lt;owl:differentFrom rdf:resource="premises002#b"/&gt;
    &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
		<test:rdfXmlPremiseOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:first="http://www.w3.org/2002/03owlt/disjointWith/premises002#"
    xml:base="http://www.w3.org/2002/03owlt/disjointWith/premises002" &gt;

   &lt;rdf:Description rdf:ID="A"&gt;
      &lt;owl:disjointWith&gt;
           &lt;rdf:Description rdf:ID="B"/&gt;
      &lt;/owl:disjointWith&gt;
   &lt;/rdf:Description&gt;
   &lt;first:A rdf:ID="a"/&gt;
   &lt;first:B rdf:ID="b"/&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
