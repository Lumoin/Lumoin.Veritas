	<test:TestCase rdf:about="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2Dimports-2D003">
		<rdf:type rdf:resource="&test;PositiveEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WebOnt-imports-003</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jeff Heflin</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a document imports a document which in turn imports a third document, then it entails
anything which is entailed by the conjunction of the statements from the three documents.
That is, imports is transitive.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Proposed" />
		<test:semantics rdf:resource="&test;DIRECT" />
		<test:semantics rdf:resource="&test;RDF-BASED" />
		<test:species rdf:resource="&test;FULL" />
		<test:rdfXmlConclusionOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
    xmlns:rdfs='http://www.w3.org/2000/01/rdf-schema#'
    xmlns:owl='http://www.w3.org/2002/07/owl#'
    xml:base='http://www.w3.org/2002/03owlt/imports/conclusions003' &gt;

    &lt;rdf:Description rdf:about='http://example.org/data#Socrates'&gt;
        &lt;rdf:type rdf:resource='http://www.w3.org/2002/03owlt/imports/support003-B#Mortal'/&gt;
    &lt;/rdf:Description&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
		<test:rdfXmlPremiseOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
    xmlns:rdfs='http://www.w3.org/2000/01/rdf-schema#'
    xmlns:owl='http://www.w3.org/2002/07/owl#'
    xmlns:ont='http://www.w3.org/2002/03owlt/imports/support003-A#'
    xml:base='http://www.w3.org/2002/03owlt/imports/premises003' &gt;

    &lt;rdf:Description rdf:about=''&gt;
        &lt;owl:imports rdf:resource='http://www.w3.org/2002/03owlt/imports/support003-A'/&gt;
    &lt;/rdf:Description&gt;

    &lt;ont:Man rdf:about='http://example.org/data#Socrates'/&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
		<test:importedOntology rdf:resource="http://owl.semanticweb.org/id/WebOnt-2Dimports-2D003-2Dimport-2Dsupport003-2DA" />
		<test:importedOntology rdf:resource="http://owl.semanticweb.org/id/WebOnt-2Dimports-2D003-2Dimport-2Dsupport003-2DB" />
	</test:TestCase>
	<owl:NegativePropertyAssertion>
