<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The Veritas engine compiled to browser-wasm: the no-scaffolding deployment runs queries fully
       client-side, with the durable tier on OPFS and SERVICE over fetch. The Studio web app boots this
       in a Web Worker (src/services/wasm-engine.ts) and reaches it through WasmVeritasTransport.
       BUILD: needs `dotnet workload install wasm-tools`. Not verified in staging; pin + verify on placement. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The JSExport source generator emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- JS interop ([JSExport]/[JSImport]) is enabled by the WebAssembly SDK; the engine is AOT/trim-safe.
         Single-threaded first: the engine's compute lane degrades correctly to no-thread on WASM, and this
         avoids the SharedArrayBuffer/COOP-COEP requirement. Revisit WasmEnableThreads once measured. -->
    <WasmEnableThreads>false</WasmEnableThreads>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Database brings the engine facade (+ Core, Sparql transitively). The serialization projects
         (Rdf.Json, …) are intentionally NOT referenced — apps emit their own wire format; the SPARQL
         results-JSON is written in SparqlResultsJson.cs over the public result API. -->
    <ProjectReference Include="..\Lumoin.Veritas.Database\Lumoin.Veritas.Database.csproj" />
    <ProjectReference Include="..\Lumoin.Veritas.Turtle\Lumoin.Veritas.Turtle.csproj" />
  </ItemGroup>

</Project>
