<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The Veritas engine compiled to browser-wasm: the no-scaffolding deployment runs queries fully
       client-side, with the durable tier on OPFS and SERVICE over fetch. The Studio web app boots this
       in a Web Worker (src/services/wasm-engine.ts) and reaches it through WasmVeritasTransport.
       BUILD: needs `dotnet workload install wasm-tools`. Not verified in staging; pin + verify on placement. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- JS interop ([JSExport]/[JSImport]) is enabled by the WebAssembly SDK; the engine is AOT/trim-safe. -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumoin.Veritas.Database\Lumoin.Veritas.Database.csproj" />
    <ProjectReference Include="..\Lumoin.Veritas.Rdf.Json\Lumoin.Veritas.Rdf.Json.csproj" />
    <ProjectReference Include="..\Lumoin.Veritas.Turtle\Lumoin.Veritas.Turtle.csproj" />
  </ItemGroup>

</Project>
