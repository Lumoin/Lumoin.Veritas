<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>veritas</ToolCommandName>

    <Title>Veritas command-line, MCP, and SPARQL HTTP server</Title>
    <Description>A command-line tool, Model Context Protocol server, and SPARQL 1.1 Protocol HTTP endpoint over the Lumoin.Veritas RDF / SPARQL / SHACL engine.</Description>

    <!--
      The CLI keeps the repository-wide trim/AOT analysis on (inherited IsAotCompatible /
      EnableTrimAnalyzer), so every build verifies it stays AOT-safe: the Kestrel endpoint
      uses the slim host builder and the MCP tool surface is statically registered. The
      native-AOT binary is produced per RID by the aot-conformance CI job, which passes
      `-r <rid> -p:PublishAot=true` at publish time — kept off the project so the ordinary
      build/test legs do not pull the per-RID ILCompiler into the locked restore.
    -->
  </PropertyGroup>

  <!--
    The repository declares browser as a supported platform for non-test projects; the
    Kestrel HTTP server is not reachable on browser, so the declaration is removed here to
    keep the platform-compatibility analyzer accurate for this application.
  -->
  <ItemGroup>
    <SupportedPlatform Remove="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumoin.Veritas.Sparql\Lumoin.Veritas.Sparql.csproj" />
    <ProjectReference Include="..\Lumoin.Veritas.Turtle\Lumoin.Veritas.Turtle.csproj" />
    <ProjectReference Include="..\Lumoin.Veritas.NQuads\Lumoin.Veritas.NQuads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp" />
  </ItemGroup>

</Project>
