<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    Core library packages allowed in any project. Library projects, the serialization
    projects (Lumoin.Veritas.Json.Stj, Lumoin.Veritas.Rdf.Json, Lumoin.Veritas.Cbor),
    test projects, and benchmark projects may all reference these.
  -->
  <ItemGroup Label="Library">
    <PackageVersion Include="Lumoin.Base" Version="0.0.9" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
    <PackageVersion Include="SIL.ReleaseTasks" Version="3.2.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.11" />
  </ItemGroup>
  <!--
    Serialization packages restricted to the serialization projects (Lumoin.Veritas.Json.Stj,
    Lumoin.Veritas.Rdf.Json, Lumoin.Veritas.Cbor) and to test and benchmark projects. Library
    projects must remain
    serialization-agnostic so consumers can pick their serialization layer at composition
    time; pulling System.Text.Json (or any future serialization runtime such as
    System.Formats.Cbor) into a library project violates that contract.
  -->
  <ItemGroup Label="Serialization">
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.11" />
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>
  <!--
    Test packages restricted to *.Tests projects. Library, serialization, and benchmark
    projects must not reference any of these. The validation task below fails the build
    when a project outside *.Tests pulls one in.
  -->
  <ItemGroup Label="Test">
    <!--
      The MSTest runner stack (MSTest.TestAdapter/TestFramework and the Microsoft.Testing.Extensions.*
      family) is version-governed by the MSTest.Sdk pin in global.json, which injects matching
      PackageVersion items under central package management — a duplicate entry here is a restore error.
    -->
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="LiquidTestReports.Markdown" Version="2.0.0-beta.6" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>
  <!--
    Benchmark packages restricted to *.Benchmarks projects. Library, serialization, and
    test projects must not reference any of these.
  -->
  <ItemGroup Label="Benchmark">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <!--
    CLI/application packages restricted to the Lumoin.Veritas.Cli application project. The
    library, serialization, test, and benchmark projects must not reference any of these;
    the CLI is the composition root that hosts the command-line, MCP, and HTTP surfaces over
    the otherwise transport-free library.
  -->
  <ItemGroup Label="Cli">
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>
  <!--
    Consensus/replication packages: the Lumoin.Verisync stack (CRDTs, causal contexts,
    CASPaxos consensus, authenticated log replay). Scoped out of the Library label so the
    transport-free core and the serialization projects never take a replication dependency.
    Consumed by test and benchmark projects (which bypass scope validation) for the wiring
    and convergence checks, and — if a dedicated replication library is added later — by that
    library once it is granted this label in the validation target.
  -->
  <ItemGroup Label="Consensus">
    <PackageVersion Include="Lumoin.Verisync.Core" Version="0.0.10" />
    <PackageVersion Include="Lumoin.Verisync.Json" Version="0.0.10" />
    <PackageVersion Include="Lumoin.Verisync.Cbor" Version="0.0.10" />
  </ItemGroup>
  <!--
    Serialization project names whose project references are restricted to test and
    benchmark projects only. Library projects must not take a project reference to any
    project listed here, keeping the core stack serialization-agnostic. Serialization
    projects themselves must not reference each other (Json and Cbor are architectural
    peers, not a dependency chain).
  -->
  <PropertyGroup>
    <RestrictedSerializationProjects>Lumoin.Veritas.Cbor;Lumoin.Veritas.Json.Stj;Lumoin.Veritas.Rdf.Json</RestrictedSerializationProjects>
  </PropertyGroup>
  <!--
    Validates that a project does not reference packages outside its allowed set of labels.
    Library projects are limited to the Library label. The serialization projects
    (Lumoin.Veritas.Json.Stj, Lumoin.Veritas.Rdf.Json, Lumoin.Veritas.Cbor) additionally
    allow the Serialization label.
    Test and benchmark projects skip validation; they may reference any package.
    Runs after package references are collected but before compilation begins. Skips
    validation during design-time builds for IDE responsiveness.
  -->
  <Target Name="ValidatePackageUsage" AfterTargets="CollectPackageReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_IsTestProject Condition="'$(IsTestApplication)' == 'true'">true</_IsTestProject>
      <_IsBenchmarkProject Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">true</_IsBenchmarkProject>
      <_IsSerializationProject Condition="'$(MSBuildProjectName)' == 'Lumoin.Veritas.Json.Stj' OR '$(MSBuildProjectName)' == 'Lumoin.Veritas.Rdf.Json' OR '$(MSBuildProjectName)' == 'Lumoin.Veritas.Cbor'">true</_IsSerializationProject>
      <_IsCliProject Condition="'$(MSBuildProjectName)' == 'Lumoin.Veritas.Cli'">true</_IsCliProject>
      <_IsLibraryProject Condition="'$(_IsTestProject)' != 'true' AND '$(_IsBenchmarkProject)' != 'true' AND '$(_IsSerializationProject)' != 'true' AND '$(_IsCliProject)' != 'true'">true</_IsLibraryProject>
      <_AdditionalAllowedLabels Condition="'$(_IsSerializationProject)' == 'true'">Serialization</_AdditionalAllowedLabels>
      <_AdditionalAllowedLabels Condition="'$(_IsCliProject)' == 'true'">Cli;Serialization</_AdditionalAllowedLabels>
      <!-- The dedicated replication library is the active-active home: it is granted the Consensus label
           so it (and only it, among library projects) may reference the Lumoin.Verisync rateless tier. -->
      <_AdditionalAllowedLabels Condition="'$(MSBuildProjectName)' == 'Lumoin.Veritas.Replication'">Consensus</_AdditionalAllowedLabels>
    </PropertyGroup>
    <ValidateScopedPackages Condition="('$(_IsLibraryProject)' == 'true' OR '$(_IsSerializationProject)' == 'true' OR '$(_IsCliProject)' == 'true') AND '@(PackageReference)' != ''" ProjectName="$(MSBuildProjectName)" PackageReferences="@(PackageReference)" DirectoryPackagesPropsPath="$(MSBuildThisFileFullPath)" AdditionalAllowedLabels="$(_AdditionalAllowedLabels)" />
  </Target>
  <!--
    Validates that the serialization projects are referenced only by test and benchmark
    projects, plus the explicitly whitelisted Lumoin.Veritas.CborLd library, which layers
    CBOR-LD semantics on top of Lumoin.Veritas.Cbor and intentionally takes that dependency,
    and Lumoin.Veritas.JsonLd, which transitively reaches Lumoin.Veritas.Cbor through
    Lumoin.Veritas.CborLd. Every other library project and the serialization projects
    themselves cannot take a project reference to any project listed in
    RestrictedSerializationProjects. Runs after project references are resolved.
  -->
  <Target Name="ValidateProjectReferences" AfterTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_IsTestProject Condition="'$(IsTestApplication)' == 'true'">true</_IsTestProject>
      <_IsBenchmarkProject Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">true</_IsBenchmarkProject>
      <_IsCborLdProject Condition="'$(MSBuildProjectName)' == 'Lumoin.Veritas.CborLd'">true</_IsCborLdProject>
      <!-- JsonLd transitively references Lumoin.Veritas.Cbor through Lumoin.Veritas.CborLd;
           the CBOR-LD input-node adapter in JsonLd intentionally takes that edge. -->
      <_IsJsonLdProject Condition="'$(MSBuildProjectName)' == 'Lumoin.Veritas.JsonLd'">true</_IsJsonLdProject>
      <!-- BenchmarkDotNet generates an autogenerated host project at runtime that
           references the benchmark assembly; the generated name is not under our
           control. Exempt it explicitly. -->
      <_IsBdnAutogeneratedProject Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">true</_IsBdnAutogeneratedProject>
      <!-- The CLI application is a composition root: it picks the serialization layer (e.g. the
           STJ JSON adapter for JSON-LD / SPARQL-JSON results) the same way the test projects do. -->
      <_IsCliProject Condition="'$(MSBuildProjectName)' == 'Lumoin.Veritas.Cli'">true</_IsCliProject>
      <!-- The Studio apps (the in-browser WASM engine, the native host) are composition roots too: each
           picks the serialization layer (SPARQL-JSON results) the same way the CLI does. -->
      <_IsStudioApp Condition="$(MSBuildProjectName.StartsWith('Lumoin.Veritas.Studio'))">true</_IsStudioApp>
      <_IsAllowedToReferenceSerializationProjects Condition="'$(_IsTestProject)' == 'true' OR '$(_IsBenchmarkProject)' == 'true' OR '$(_IsCborLdProject)' == 'true' OR '$(_IsJsonLdProject)' == 'true' OR '$(_IsBdnAutogeneratedProject)' == 'true' OR '$(_IsCliProject)' == 'true' OR '$(_IsStudioApp)' == 'true'">true</_IsAllowedToReferenceSerializationProjects>
    </PropertyGroup>
    <ValidateSerializationProjectReferences Condition="'$(_IsAllowedToReferenceSerializationProjects)' != 'true' AND '@(ProjectReference)' != ''" ProjectName="$(MSBuildProjectName)" ProjectReferences="@(ProjectReference)" RestrictedProjects="$(RestrictedSerializationProjects)" />
  </Target>
  <!--Inline Roslyn task for validating package references. Compiled once per build session and cached in memory.-->
  <UsingTask TaskName="ValidateScopedPackages" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectName Required="true" />
      <PackageReferences ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <DirectoryPackagesPropsPath Required="true" />
      <AdditionalAllowedLabels Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            //Early exit if no package references.
            if(PackageReferences == null || PackageReferences.Length == 0)
            {
                return true;
            }

            //Build the set of labels this project is allowed to pull from. The Library
            //label is always allowed; AdditionalAllowedLabels lets the serialization
            //projects opt into the Serialization label without changing this task's
            //surface for ordinary library projects.
            var allowedLabels = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "Library"
            };

            if(!string.IsNullOrEmpty(AdditionalAllowedLabels))
            {
                foreach(var extraLabel in AdditionalAllowedLabels.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    allowedLabels.Add(extraLabel);
                }
            }

            //Parse Directory.Packages.props and collect every package whose label is not
            //in the allowed set; these are the packages this project must not reference.
            var doc = XDocument.Load(DirectoryPackagesPropsPath);
            var nsUsed = doc.Root.Name.Namespace;

            var scopedPackages = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach(var itemGroup in doc.Descendants(nsUsed + "ItemGroup"))
            {
                var label = itemGroup.Attribute("Label")?.Value;
                if(!string.IsNullOrEmpty(label) && !allowedLabels.Contains(label))
                {
                    foreach(var packageVersion in itemGroup.Elements(nsUsed + "PackageVersion"))
                    {
                        var packageName = packageVersion.Attribute("Include")?.Value;
                        if(!string.IsNullOrEmpty(packageName))
                        {
                            scopedPackages[packageName] = label;
                        }
                    }
                }
            }

            //Walk the project's package references and flag any that fall in the disallowed set.
            var violations = new List<string>();
            foreach(var pkgRef in PackageReferences)
            {
                if(scopedPackages.TryGetValue(pkgRef.ItemSpec, out var label))
                {
                    violations.Add($"{pkgRef.ItemSpec} (Label: {label})");
                }
            }

            if(violations.Count > 0)
            {
                Log.LogError(
                    $"Restricted package(s) '{string.Join(", ", violations)}' " +
                    $"referenced in project '{ProjectName}'. " +
                    "These packages are scoped to a project type that does not include this project.");
                return false;
            }

            return true;
        }
        ]]></Code>
    </Task>
  </UsingTask>
  <!--
    Inline Roslyn task for validating project references to serialization projects.
    Ensures that only test and benchmark projects (plus the whitelisted CborLd / JsonLd
    libraries) can take a project reference to a restricted serialization project. Compiled
    once per build session and cached in memory.
  -->
  <UsingTask TaskName="ValidateSerializationProjectReferences" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectName Required="true" />
      <ProjectReferences ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <RestrictedProjects Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            //Early exit if no project references.
            if(ProjectReferences == null || ProjectReferences.Length == 0)
            {
                return true;
            }

            //Parse the semicolon-delimited list of restricted project names.
            var restricted = new HashSet<string>(
                RestrictedProjects.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries),
                StringComparer.OrdinalIgnoreCase);

            //Extract the project name from each reference path and check against the restricted set.
            var violations = new List<string>();
            foreach(var projRef in ProjectReferences)
            {
                var referencedProjectName = Path.GetFileNameWithoutExtension(projRef.ItemSpec);
                if(restricted.Contains(referencedProjectName))
                {
                    violations.Add(referencedProjectName);
                }
            }

            if(violations.Count > 0)
            {
                Log.LogError(
                    $"Restricted project reference(s) '{string.Join(", ", violations)}' " +
                    $"found in '{ProjectName}'. " +
                    "The serialization projects (Lumoin.Veritas.Cbor, Lumoin.Veritas.Json.Stj, Lumoin.Veritas.Rdf.Json) can only be referenced by *.Tests and *.Benchmarks projects (plus the whitelisted CborLd / JsonLd libraries).");
                return false;
            }

            return true;
        }
        ]]></Code>
    </Task>
  </UsingTask>
</Project>